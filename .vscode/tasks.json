{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: build active file",
            "type": "process",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++14", "-Wall", "-Wextra", "-g",
                "-isysroot",
                "/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk",
                "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "C: build active file",
            "type": "process",
            "command": "/usr/bin/clang",
            "args": [
                "-std=c17", "-Wall", "-Wextra", "-g",
                "-isysroot",
                "/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk",
                "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": "build"
        }
    ]
}
