{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: build active file",
            "type": "process",
            "command": "/opt/homebrew/bin/g++-16",
            "args": [
                "-std=c++14", "-Wall", "-Wextra", "-g",
                "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "C: build active file",
            "type": "process",
            "command": "/opt/homebrew/bin/gcc-16",
            "args": [
                "-std=c17", "-Wall", "-Wextra", "-g",
                "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": "build"
        }
    ]
}
